# 智立法 · Docker Compose 环境变量样例
# 真实值应放在同目录 .env(已 gitignore)中,本文件只用于演示

# ----- 数据库 -----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=legal_legislation
DB_USER=root
DB_PASSWORD=root123

# ----- Neo4j 知识图谱 -----
NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=legislation@2026

# ----- JWT -----
JWT_SECRET=legislationIntelligencePlatformSecretKey2026PaddedForHmac256
JWT_EXPIRATION=86400000

# ----- Qwen / DashScope(留空表示 offline 模式) -----
QWEN_MODE=offline
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
QWEN_MODEL=qwen-plus
AI_DRAFT_ENABLED=false
AI_REVIEW_ENABLED=false
AI_EVAL_ENABLED=false

# ----- Grafana -----
GRAFANA_PASSWORD=admin
