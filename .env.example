# ===== 立法版后端环境变量样例 =====
# 复制为 .env 后填入真实值;生产环境请用密钥管理服务注入,不要把 .env 提交到仓库

# ----- 数据库 -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=legal_legislation
DB_USER=root
DB_PASSWORD=root123

# ----- Neo4j 知识图谱(可选) -----
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=legislation@2026

# ----- JWT -----
# 至少 32 字节;生产请用 openssl rand -base64 64 生成
JWT_SECRET=legislationIntelligencePlatformSecretKey2026PaddedForHmac256
JWT_EXPIRATION=86400000

# ----- AI(Qwen / DashScope) -----
# 去 https://dashscope.aliyun.com/apiKey 申请
DASHSCOPE_API_KEY=
AI_MODEL=qwen-long
AI_DRAFT_ENABLED=false
AI_REVIEW_ENABLED=false
AI_EVAL_ENABLED=false
